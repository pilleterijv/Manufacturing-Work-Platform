generator client {
 provider = "prisma-client-js"
 engineType = "client"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
model User {
 id String @id @default(uuid())
 username String @unique
 name String
 password String
 role String
 active Boolean @default(true)
 mustChange Boolean @default(true)
 version Int @default(1)
 sessions Session[]
 records Record[]
 photos Photo[]
 downtimeStarted Downtime[] @relation("DowntimeStarter")
 downtimeStopped Downtime[] @relation("DowntimeStopper")
 ideasCreated Idea[] @relation("IdeaCreator")
 ideasSubmitted Idea[] @relation("IdeaSubmitter")
 ideasPiloted Idea[] @relation("IdeaPilot")
 ideasValidated Idea[] @relation("IdeaValidator")
 ideaParticipations IdeaParticipant[]
 notifications Notification[]
}
model Session {
 token String @id
 userId String
 version Int
 expires DateTime
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model Equipment {
 id String @id @default(uuid())
 name String
 plant String
 department String
 area String
 line String
 standards Standard[]
 downtime Downtime[]
 ideas Idea[]
}
model Standard {
 id String @id @default(uuid())
 family String
 revision Int
 title String
 equipmentId String
 target Float
 tolerance Float
 steps Json
 created DateTime @default(now())
 equipment Equipment @relation(fields:[equipmentId],references:[id])
 records Record[]
 @@unique([family,revision])
}
model Record {
 id String @id @default(uuid())
 kind String
 userId String
 standardId String?
 data Json
 created DateTime @default(now())
 user User @relation(fields:[userId],references:[id])
 standard Standard? @relation(fields:[standardId],references:[id])
}
model Content {
 id String @id @default(uuid())
 kind String
 title String
 equipmentId String?
 body String
 active Boolean @default(true)
}
model Policy {
 role String @id
 grants Json
}
model Photo {
 id String @id @default(uuid())
 userId String
 created DateTime @default(now())
 user User @relation(fields:[userId],references:[id])
}
model Rate {
 key String @id
 count Int
 expires DateTime
}
model DowntimeReason {
 id String @id @default(uuid())
 name String @unique
 active Boolean @default(true)
 events Downtime[]
}
model Downtime {
 id String @id @default(uuid())
 equipmentId String
 reasonId String
 reasonName String
 equipmentSnapshot Json
 shiftConfig Json
 startedAt DateTime @default(now())
 endedAt DateTime?
 startedBy String
 stoppedBy String?
 equipment Equipment @relation(fields:[equipmentId],references:[id])
 reason DowntimeReason @relation(fields:[reasonId],references:[id])
 starter User @relation("DowntimeStarter",fields:[startedBy],references:[id])
 stopper User? @relation("DowntimeStopper",fields:[stoppedBy],references:[id])
 @@index([startedAt])
}
model Setting {
 key String @id
 value Json
}
model Idea {
 id String @id @default(uuid())
 title String
 equipmentId String
 equipmentSnapshot Json
 currentState String
 proposal String
 dueDate String
 status String @default("Open")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 createdBy String
 submitterId String
 pilotId String
 validatorId String
 version Int @default(1)
 equipment Equipment @relation(fields:[equipmentId],references:[id])
 creator User @relation("IdeaCreator",fields:[createdBy],references:[id])
 submitter User @relation("IdeaSubmitter",fields:[submitterId],references:[id])
 pilot User @relation("IdeaPilot",fields:[pilotId],references:[id])
 validator User @relation("IdeaValidator",fields:[validatorId],references:[id])
 participants IdeaParticipant[]
 notifications Notification[]
 @@index([createdAt])
}
model IdeaParticipant {
 ideaId String
 userId String
 idea Idea @relation(fields:[ideaId],references:[id])
 user User @relation(fields:[userId],references:[id])
 @@id([ideaId,userId])
}
model Notification {
 id String @id @default(uuid())
 userId String
 ideaId String
 message String
 createdAt DateTime @default(now())
 readAt DateTime?
 user User @relation(fields:[userId],references:[id])
 idea Idea @relation(fields:[ideaId],references:[id])
 @@index([userId,createdAt])
}
