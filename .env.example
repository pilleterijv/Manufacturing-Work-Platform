DATABASE_URL=postgresql://work:work@localhost:5432/work_rebuild
APP_ORIGIN=http://localhost:3000
# Optional Azure Blob private container:
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=floorwork

# Optional manager email delivery. Store real secrets only in private settings.
# SMTP_HOST=smtp.your-company.example
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=floorwork@your-company.example
# SMTP_USER=
# SMTP_PASSWORD=

# Optional READ-ONLY Microsoft SQL Server / Azure SQL event bridge.
# IT supplies the actual host, database, login and approved schema.view.
# COMPANY_SQL_SERVER=your-server.database.windows.net
# COMPANY_SQL_PORT=1433
# COMPANY_SQL_DATABASE=
# COMPANY_SQL_USER=
# COMPANY_SQL_PASSWORD=
# COMPANY_SQL_VIEW=dbo.FloorworkDowntimeEvents
# COMPANY_SQL_SOURCE_ID=
# For hosting with a separate worker service only:
# FLOORWORK_WORKER_MODE=external

# Optional MaintainX work-order submission (Premium/Enterprise API entitlement).
# Configure machine-to-asset IDs in Defect reporting as Admin.
# MAINTAINX_API_KEY=
# MAINTAINX_ORGANIZATION_ID=

# Optional read-only navigation AI. Admin must also enable it in Assistant.
# OPENAI_API_KEY=
# OPENAI_ASSISTANT_MODEL=
