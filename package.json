    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "next": "^16.4.3",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.58.2",
    "prettier": "^3.9.10",
    "prisma": "6.19.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
